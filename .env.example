# Copy to .env and fill in. Model IDs from the Fireworks model library.
FIREWORKS_API_KEY=
VISION_MODEL=accounts/fireworks/models/<small-vision-model>
TEXT_MODEL=accounts/fireworks/models/<cheap-text-model>
ESCALATION_MODEL=accounts/fireworks/models/<large-model>
# USD per million tokens
VISION_MODEL_INPUT_PRICE=
VISION_MODEL_OUTPUT_PRICE=
TEXT_MODEL_INPUT_PRICE=
TEXT_MODEL_OUTPUT_PRICE=
ESCALATION_MODEL_INPUT_PRICE=
ESCALATION_MODEL_OUTPUT_PRICE=
# Reasoning effort per model: none | low | medium | high (empty = model default)
VISION_MODEL_REASONING_EFFORT=
TEXT_MODEL_REASONING_EFFORT=
ESCALATION_MODEL_REASONING_EFFORT=
MAX_OUTPUT_TOKENS=8000
REQUEST_TIMEOUT_S=120
# Ambiguous dates like 07/10/2020: auto (month first for USD, else day first) | MDY | DMY
AMBIGUOUS_DATE_ORDER=auto
